# Codex CLI uses its existing login; project model defaults are in config/llm.json.
CHIZU_LLM_PROVIDER=codex-cli
# Optional model override. Never prefix credentials with VITE_.
CHIZU_LLM_MODEL=
# Only needed if CHIZU_LLM_PROVIDER=responses:
CHIZU_LLM_BASE_URL=https://api.openai.com/v1
CHIZU_LLM_API_KEY=
CHIZU_PORT=8787
