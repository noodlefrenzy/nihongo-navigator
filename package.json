{
  "name": "chizu",
  "version": "0.0.0",
  "description": "Learn Japanese place-name readings on an interactive map of Japan.",
  "license": "MIT",
  "author": "noodlefrenzy",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlefrenzy/nihongo-navigator.git"
  },
  "bugs": {
    "url": "https://github.com/noodlefrenzy/nihongo-navigator/issues"
  },
  "homepage": "https://github.com/noodlefrenzy/nihongo-navigator#readme",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "node scripts/check-map-data.mjs && vite --host 0.0.0.0",
    "dev:server": "node scripts/check-map-data.mjs && node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test --test-isolation=none server/*.test.mjs",
    "check:dependency-policy": "node scripts/check-dependency-age.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "data:build": ".venv/bin/python scripts/data_build.py",
    "data:validate": "node --experimental-strip-types scripts/validate-data.mjs",
    "content:build": "node scripts/build-content.mjs"
  },
  "dependencies": {
    "wanakana": "5.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "maplibre-gl": "5.6.1",
    "pmtiles": "4.3.0",
    "zustand": "5.0.5",
    "dexie": "4.0.11",
    "ts-fsrs": "5.2.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "vite": "6.3.5",
    "@vitejs/plugin-react": "4.5.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@playwright/test": "1.53.1"
  }
}
